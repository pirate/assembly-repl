{
  "name": "assembly-repl",
  "version": "0.1.0",
  "description": "Unsafe native assembly REPL for Apple Silicon macOS (arm64) and Linux x86_64",
  "license": "MIT",
  "homepage": "https://github.com/pirate/assembly-repl#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pirate/assembly-repl.git"
  },
  "bugs": {
    "url": "https://github.com/pirate/assembly-repl/issues"
  },
  "bin": {
    "assembly-repl": "./bin/assembly-repl.js"
  },
  "files": [
    "bin/",
    "prebuilds/",
    "README.md",
    "src/",
    "Makefile"
  ],
  "scripts": {
    "build": "make",
    "start": "node ./bin/assembly-repl.js",
    "pack:check": "pnpm pack --pack-destination /tmp"
  },
  "keywords": [
    "assembly",
    "arm64",
    "aarch64",
    "x86_64",
    "x64",
    "linux",
    "repl",
    "jit",
    "apple-silicon"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2"
}
