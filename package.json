{
  "name": "assembly-repl",
  "version": "0.1.1",
  "description": "Native raw assembly, WebAssembly, LLVM IR, C, C++, and Objective C REPLs for macOS and Linux",
  "license": "MIT",
  "homepage": "https://github.com/pirate/assembly-repl#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pirate/assembly-repl.git"
  },
  "bugs": {
    "url": "https://github.com/pirate/assembly-repl/issues"
  },
  "bin": {
    "assembly-repl": "./bin/repl.js",
    "c-repl": "./bin/c-repl.js",
    "cpp-repl": "./bin/cpp-repl.js",
    "objc-repl": "./bin/objc-repl.js",
    "llvmir-repl": "./bin/llvmir-repl.js",
    "wasm-repl": "./bin/wasm-repl.js"
  },
  "files": [
    "bin/",
    "src/",
    "Makefile",
    ".dockerignore",
    "Dockerfile",
    "prebuilds/",
    "README.md"
  ],
  "scripts": {
    "build": "node ./bin/build.js",
    "start": "node ./bin/repl.js"
  },
  "keywords": [
    "assembly",
    "arm64",
    "aarch64",
    "x86_64",
    "x64",
    "c",
    "cpp",
    "objective-c",
    "wasm",
    "webassembly",
    "llvm",
    "llvm-ir",
    "linux",
    "repl",
    "jit",
    "apple-silicon"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "ansi-colors": "^4.1.3"
  }
}
